---
import { footer } from "../utils/content";
---

<footer class="border-t border-white/5 bg-black/20 backdrop-blur-md pt-20">
  <div class="container pb-20">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 items-start">
      <!-- START: LOGO -->
      <div class="flex flex-col gap-6">
        <div class="flex items-center gap-3">
          <img
            src="/img/new/3.png"
            alt="GamanJS"
            class="h-10 w-auto"
          />
          <span class="text-2xl font-black tracking-tighter text-white uppercase italic">GamanJS</span>
        </div>
        <p class="text-slate-500 text-sm leading-relaxed max-w-xs">
            A high-performance, functional-first backend framework built for the modern enterprise.
        </p>
      </div>
      <!-- END: LOGO -->

      <!-- START: DOCUMENTATION -->
      <div>
        <h5 class="font-bold text-white uppercase tracking-widest text-xs mb-8">
          {footer.documents.title}
        </h5>
        <div class="flex flex-col gap-4">
          {
            footer.documents.links.map((item) => (
              <a
                class="text-sm text-slate-500 hover:text-blue-400 transition-colors"
                href={item.url}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
      <!-- END: DOCUMENTATION -->

      <!-- START: COMMUNITY -->
      <div>
        <h5 class="font-bold text-white uppercase tracking-widest text-xs mb-8">
          {footer.community.title}
        </h5>
        <div class="flex flex-col gap-4">
          {
            footer.community.links.map((item) => (
              <a
                target="_blank"
                class="text-sm text-slate-500 hover:text-blue-400 transition-colors"
                href={item.url}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
      <!-- START: COMMUNITY -->

      <!-- START: RESOURCE -->
      <div>
        <h5 class="font-bold text-white uppercase tracking-widest text-xs mb-8">
          {footer.resource.title}
        </h5>
        <div class="flex flex-col gap-4">
          {
            footer.resource.links.map((item) => (
              <a
                class="text-sm text-slate-500 hover:text-blue-400 transition-colors"
                href={item.url}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
      <!-- START: RESOURCE -->
    </div>
  </div>
  
  <div class="border-t border-white/5 py-8">
    <div class="container flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-medium text-slate-600 uppercase tracking-widest">
        <p>&copy; {new Date().getFullYear()} GamanJS. ALL RIGHTS RESERVED.</p>
        <div class="flex gap-8">
            <a href="https://gaman.7togk.id" class="hover:text-white transition-colors">7TogkID</a>
            <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy</a>
            <a href="/terms-of-service" class="hover:text-white transition-colors">Terms</a>
        </div>
    </div>
  </div>
</footer>
