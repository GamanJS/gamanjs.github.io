---
import CodeTabs from "../components/CodeTabs.tsx";
import Contributors from "../components/Contributors.tsx";
import GamanLivePreview from "../components/GamanLivePreview.tsx";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import HeroSection from "../components/sections/HeroSection.tsx";
import "../styles/global.css";
import { features, plugins } from "../utils/content";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GamanJS - Backend Framework</title>
    <link
      id="favicon"
      rel="icon"
      type="image/png"
      href="/img/new/3.png"
    />

    <script is:inline>
      const favicon = document.getElementById("favicon");
      const activeIcon = "/img/new/3.png"; // saat tab aktif
      const inactiveIcon = "/img/new/2.png"; // saat tab tidak aktif

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          favicon.href = inactiveIcon;
        } else {
          favicon.href = activeIcon;
        }
      });
    </script>
  </head>
  <body class="bg-bg-primary text-blue-100 relative overflow-x-hidden">
    <!-- START: GRID BACKGROUND -->
    <div class="fixed inset-0 z-[-1] pointer-events-none opacity-[0.03]" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    
    <Navbar />
    <main class="relative">
      <HeroSection client:load />
 <!-- START: CODE TABS DEMO -->
      <section class="relative py-10 px-4">
        <div class="max-w-6xl mx-auto">
          <h3
            class="text-3xl md:text-4xl font-bold mb-4 bg-gradient-to-r from-blue-500 via-indigo-400 to-white bg-clip-text text-transparent"
          >
            Lean Architecture for Scale
          </h3>
          <p class="w-[90%] text-text-primary mb-10">
            GamanJS adopts a lean, <span class="text-blue-300">functional-first</span>
            design engineered for high-scale environments. Rejecting bloated OOP patterns, everything is built through <span class="text-indigo-300"
              >composable functions</span
            > like
            <code class="bg-white/10 px-1.5 py-0.5 rounded-md text-blue-200"
              >compose</code
            >,
            <code class="bg-white/10 px-1.5 py-0.5 rounded-md text-blue-200"
              >define</code
            >, and <code
              class="bg-white/10 px-1.5 py-0.5 rounded-md text-blue-200"
              >mount</code
            >. This ensures your backend remains declarative, robust, and capable of heavy-duty performance.
          </p>

          <CodeTabs client:load />
        </div>
      </section>

      <!-- START: FEATURE SHOWCASE -->
      <section class="relative py-24 px-4 overflow-hidden">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
            <div>
              <h3 class="text-4xl font-bold mb-6 bg-gradient-to-r from-blue-400 to-white bg-clip-text text-transparent">
                Modular by Design
              </h3>
              <p class="text-lg text-blue-100/70 leading-relaxed mb-8">
                GamanJS enforces a <span class="text-blue-300 font-semibold">feature-first</span> structure. 
                Keep your logic isolated, your controllers clean, and your scaling predictable.
              </p>
              
              <div class="space-y-6">
                <div class="flex gap-4 items-start">
                  <div class="p-2 rounded-lg bg-blue-500/20 border border-blue-500/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                  </div>
                  <div>
                    <h4 class="text-lg font-bold text-white mb-1">Encapsulated Modules</h4>
                    <p class="text-blue-100/60 font-medium">Group logic by features, not layers. Scalability starts with boundaries.</p>
                  </div>
                </div>
                
                <div class="flex gap-4 items-start">
                  <div class="p-2 rounded-lg bg-indigo-500/20 border border-indigo-500/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                  </div>
                  <div>
                    <h4 class="text-lg font-bold text-white mb-1">Functional Composition</h4>
                    <p class="text-blue-100/60 font-medium">Compose your backend with pure functions. No hidden state, no complex classes.</p>
                  </div>
                </div>

                <div class="flex gap-4 items-start">
                  <div class="p-2 rounded-lg bg-purple-500/20 border border-purple-500/30">
                     <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
                  </div>
                  <div>
                    <h4 class="text-lg font-bold text-white mb-1">Type-Safe DI</h4>
                    <p class="text-blue-100/60 font-medium">First-class support for dependency injection through simple function destructuring.</p>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="relative group">
              <div class="absolute -inset-1 bg-gradient-to-r from-blue-500 to-indigo-500 rounded-2xl blur opacity-25 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
              <div class="relative bg-stone-900 border border-white/10 rounded-2xl p-8 shadow-2xl backdrop-blur-xl">
                <div class="flex items-center gap-2 mb-6">
                  <div class="w-3 h-3 rounded-full bg-red-500"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                  <div class="w-3 h-3 rounded-full bg-green-500"></div>
                  <span class="ml-4 text-stone-500 font-mono text-sm">src/modules/billing/</span>
                </div>
                <div class="font-mono text-sm space-y-3">
                  <div class="flex gap-3 text-stone-400">
                    <span class="text-blue-400">├──</span>
                    <span>controllers/BillingController.ts</span>
                  </div>
                  <div class="flex gap-3 text-stone-400">
                    <span class="text-blue-400">├──</span>
                    <span>services/TaxService.ts</span>
                  </div>
                  <div class="flex gap-3 text-stone-400">
                    <span class="text-blue-400">├──</span>
                    <span>middlewares/AuditLog.ts</span>
                  </div>
                  <div class="flex gap-3 text-stone-400">
                    <span class="text-blue-400">└──</span>
                    <span class="text-indigo-300">BillingRoutes.ts</span>
                  </div>
                </div>
                <div class="mt-8 pt-6 border-t border-white/5">
                  <p class="text-blue-100/60 text-sm leading-relaxed">
                    Designed for teams who value <span class="text-white">clarity</span> over <span class="text-white">magic</span>. 
                    Every dependency is explicit, every route is traceable.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- START: CTA SECTION -->
      <section class="relative py-12 px-4">
        <div class="max-w-4xl mx-auto text-center py-16 px-8 rounded-3xl bg-gradient-to-b from-blue-500/10 to-indigo-500/5 border border-white/5 backdrop-blur-md">
          <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">
            Ready to Build at Scale?
          </h2>
          <p class="text-xl text-blue-100/70 mb-10 max-w-2xl mx-auto">
            Experience the logic-first framework that doesn't get in your way. 
            Light as a ghost, solid as a rock.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/docs/overview/first-steps" class="px-8 py-4 rounded-xl bg-blue-500 hover:bg-blue-400 text-white font-bold transition-all shadow-lg shadow-blue-500/20">
              Get Started for Free
            </a>
            <a href="https://github.com/7TogkID/gaman" target="_blank" class="px-8 py-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold transition-all">
              View on GitHub
            </a>
          </div>
        </div>
      </section>

      <section class="relative py-16 px-4 bg-bg-primary/40 backdrop-blur-sm">
        <div class="max-w-6xl mx-auto">
          <GamanLivePreview client:load />
        </div>
      </section>


      <!-- START: Key Features -->
      <section class="relative py-24">
        <div class="max-w-6xl mx-auto px-6 relative z-10">
          <h2 class="text-4xl md:text-5xl font-bold text-center mb-6">
            Why <span
              class="from-blue-400 to-indigo-300 bg-gradient-to-r bg-clip-text text-transparent"
              >Modern Teams</span
            >
            Choose <span
              class="from-white via-blue-100 to-blue-200 bg-gradient-to-r bg-clip-text text-transparent"
              >GamanJS</span
            >
          </h2>

          <p class="text-xl text-blue-100/60 text-center max-w-2xl mx-auto mb-16">
            {features.description}
          </p>

          <div
            class="grid grid-cols-1 md:grid-cols-2 gap-8"
          >
            {
              features.items.map((item) => {
                const Icon = item.icon;

                return (
                  <div class="group relative p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-blue-500/30 transition-all duration-500 overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-blue-500/10 to-indigo-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                    <div class="relative flex gap-6 items-start">
                      <div class="p-3 rounded-xl bg-blue-500/20 text-blue-400 group-hover:scale-110 transition-transform duration-500">
                        <Icon class="w-8 h-8" />
                      </div>
                      <div>
                        <h3 class="text-2xl font-bold text-white mb-2">
                          {item.title}
                        </h3>
                        <p class="text-blue-100/70 leading-relaxed">{item.text}</p>
                      </div>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>

        <div
          class="absolute top-1/2 left-0 w-96 h-96 bg-blue-600/10 rounded-full blur-[120px] -translate-y-1/2"
        >
        </div>
      </section>
      <!-- END: Key Features -->

      <!-- START: Plugins -->
      <!-- <section class="relative py-24 bg-white/[0.01]">
        <div class="max-w-6xl mx-auto px-6 relative z-10">
          <h2 class="text-4xl md:text-5xl font-bold text-center mb-6">
            Everything You Need, <span
              class="from-indigo-400 to-purple-400 bg-gradient-to-r bg-clip-text text-transparent"
              >Zero Bloat</span
            >
          </h2>

          <p class="text-xl text-blue-100/60 text-center max-w-2xl mx-auto mb-16">
            Official plugins for common use cases. Simple, documented, and modular.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
            {
              plugins.items.map((item) => {
                const Icon = item.icon;

                return (
                  <div class="group relative p-6 rounded-2xl bg-stone-900/50 border border-white/5 hover:border-indigo-500/30 transition-all duration-500">
                    <div class="flex items-center gap-4 mb-4">
                      <div class="p-2 rounded-lg bg-indigo-500/10 text-indigo-400 group-hover:text-blue-300 transition-colors">
                        <Icon class="w-6 h-6" />
                      </div>
                      <h4 class="text-lg font-bold text-white/90">
                        {item.title}
                      </h4>
                    </div>
                    <p class="text-sm text-blue-100/50 leading-relaxed">
                      {item.text}
                    </p>
                  </div>
                );
              })
            }
          </div>
        </div>
      </section> -->
      <!-- END: Plugins -->



      <section
        class="py-24 px-6 relative overflow-hidden"
      >
        <div class="max-w-6xl mx-auto text-center relative z-10">
          <h3
            class="text-4xl font-bold mb-6 bg-gradient-to-r from-blue-400 to-indigo-300 bg-clip-text text-transparent"
          >
            Built by Developers, for Developers
          </h3>
          <p class="text-xl text-blue-100/60 mb-12 max-w-2xl mx-auto">
            GamanJS is an open-source project shaped by community contributions.
          </p>
          <Contributors client:load />
        </div>
        
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-blue-500/20 to-transparent" />
      </section>
    </main>
  </body>

  <Footer />

  <!-- boleh di pindah ini buat matiin popup nya -->
  <style>
    .mobile-popup.active {
      opacity: 1 !important;
      transform: translateY(-50%) translateX(0) !important;
      pointer-events: auto !important;
    }
  </style>

  <script>
    // mobile popup nya ehe :3
    document.addEventListener("click", function (e) {
      if (window.matchMedia && window.matchMedia("(min-width: 768px)").matches)
        return;

      const target = e.target instanceof Element ? e.target : null;
      if (!target) return;

      const iconWrap = target.closest(".group");
      if (!iconWrap) return;
      const popup = iconWrap.querySelector(".mobile-popup");
      if (!popup) return;

      if (target.closest(".mobile-popup")) return;

      const isActive = popup.classList.toggle("active");

      //! tutup popup
      document.querySelectorAll(".mobile-popup.active").forEach((p) => {
        if (p !== popup) p.classList.remove("active");
      });

      if (isActive) document.body.style.overflow = "hidden";
      else document.body.style.overflow = "";
    });

    // tutup klik di mana saja
    document.addEventListener("touchstart", function (e) {
      if (window.matchMedia && window.matchMedia("(min-width: 768px)").matches)
        return;
      const t = e.target instanceof Element ? e.target : null;
      if (t && (t.closest(".mobile-popup") || t.closest(".group"))) return;
      document
        .querySelectorAll(".mobile-popup.active")
        .forEach((p) => p.classList.remove("active"));
      document.body.style.overflow = "";
    });
  </script>
</html>
