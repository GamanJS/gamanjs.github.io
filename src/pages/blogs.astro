---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";

const posts = [
  {
    title: "Introducing GamanJS v2",
    description: "A major overhaul focusing on functional composition and high performance.",
    date: "2024-03-29",
    category: "Announcements",
    link: "#"
  },
  {
    title: "Why Functional Programming for Backends?",
    description: "Exploring the benefits of composable functions over traditional OOP patterns.",
    date: "2024-03-25",
    category: "Technical",
    link: "#"
  },
  {
    title: "Building Scalable APIs with GamanJS",
    description: "Best practices for structuring large-scale applications with our modular design.",
    date: "2024-03-15",
    category: "Guide",
    link: "#"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blogs - GamanJS</title>
    <link rel="icon" type="image/png" href="/img/new/3.png" />
  </head>
  <body class="bg-bg-primary text-slate-100 min-h-screen flex flex-col">
    <Navbar />
    
    <div class="relative py-32 px-6">
      <div class="max-w-4xl mx-auto text-center mb-24 relative z-10">
        <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-8 tracking-tight italic uppercase leading-[1.1]">
          ENGINEERING <br/> INSIGHTS
        </h1>
        <p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed font-medium">
          Deep dives into backend architecture, performance optimization, and the philosophy behind GamanJS.
        </p>
      </div>

      <div class="max-w-5xl mx-auto grid gap-10">
        {
         posts.map((post) => (
            <article class="group relative p-10 rounded-[2.5rem] bg-white/[0.02] border border-white/5 hover:border-blue-500/20 transition-all duration-500 backdrop-blur-sm overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              
              <div class="relative flex flex-col md:flex-row gap-10 items-start">
                <div class="flex-1">
                  <div class="flex items-center gap-4 mb-6">
                    <span class="px-4 py-1.5 rounded-full bg-blue-500/10 text-blue-400 text-xs font-bold uppercase tracking-widest border border-blue-500/20">
                      {post.category}
                    </span>
                    <span class="text-slate-600 text-xs font-bold uppercase tracking-widest leading-none">
                      {post.date}
                    </span>
                  </div>
                  
                  <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 group-hover:text-blue-400 transition-colors tracking-tight">
                    <a href={post.link}>{post.title}</a>
                  </h2>
                  
                  <p class="text-slate-400 leading-relaxed font-medium text-lg mb-10">
                    {post.description}
                  </p>

                <div class="flex items-center gap-2 text-blue-400 font-semibold group/link">
                    <span>Read More</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
